# Memory-only Simulation Server. All settings are documented in nn_setup.md.
# Code Engine supplies these as environment variables / a mounted enrollment config.
PORT=8080
ENROLLMENT_CONFIG_PATH=CHANGE_ME
# Total resident factories; initial rehearsal limit, not tested capacity.
MAX_FACTORIES=25
# Six hours of wall time from successful provisioning.
FACTORY_TTL_SECONDS=21600
# Per-factory pending-event limits: 10,000 records and 16 MiB serialized bytes.
FACTORY_BUFFER_LIMIT_EVENTS=10000
FACTORY_BUFFER_LIMIT_BYTES=16777216
# Wall-clock intervals; speed multipliers do not change these intervals.
SIM_TICK_MILLISECONDS=100
SNAPSHOT_INTERVAL_MILLISECONDS=200
