{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hive.example.com/schemas/enrollment-config.json",
  "title": "EnrollmentConfig",
  "description": "Organizer-supplied workshop enrollment config.",
  "type": "object",
  "required": ["enrollments"],
  "properties": {
    "enrollments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["attendee_id", "access_token"],
        "properties": {
          "attendee_id": {
            "type": "string",
            "description": "Unique attendee identifier"
          },
          "access_token": {
            "type": "string",
            "description": "Plaintext workshop access token issued to the attendee."
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
