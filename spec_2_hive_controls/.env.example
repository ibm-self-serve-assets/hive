# Simulation server URL for connecting to the hosted workshop server.
SIMULATION_SERVER_URL=http://localhost:8080

# Workshop ID — issued by the organizer (e.g. hive-01).
WORKSHOP_ID=CHANGE_ME

# Your organizer-issued workshop token (Bearer auth with the sim server).
WORKSHOP_ACCESS_TOKEN=CHANGE_ME

# Your attendee ID — issued by the organizer (e.g. queen-042).
ATTENDEE_ID=CHANGE_ME

# -------------------------------------------------------------------
# Your Confluent Cloud cluster credentials
# All values come from YOUR cluster — attendees bring their own.
# A single "My account" API key covers topic creation, producing, and consuming.
# -------------------------------------------------------------------

# Bootstrap server — Confluent Cloud → Cluster → Cluster Settings → Bootstrap server.
# Example: pkc-xxxxx.us-west-2.aws.confluent.cloud:9092
CONFLUENT_BOOTSTRAP_SERVER=CHANGE_ME

# API key + secret — Confluent Cloud → API Keys → Add key → My account.
# Used for topic provisioning, publishing (sim server), and consuming (local backend).
CONFLUENT_API_KEY=CHANGE_ME
CONFLUENT_API_SECRET=CHANGE_ME

# -------------------------------------------------------------------
# Topic provisioning (used by provision_topics.sh only)
# -------------------------------------------------------------------

# REST endpoint — Confluent Cloud → Cluster → Cluster Settings → Endpoints → REST endpoint.
# Example: https://pkc-xxxxx.us-west-2.aws.confluent.cloud
CONFLUENT_REST_ENDPOINT=CHANGE_ME

# Cluster ID — Confluent Cloud → Cluster → Cluster Settings → General → Cluster ID.
# Example: lkc-xxxxxx
CONFLUENT_CLUSTER_ID=CHANGE_ME


LOCAL_BACKEND_HOST=127.0.0.1
LOCAL_BACKEND_PORT=8000
LOCAL_FRONTEND_PORT=5173
